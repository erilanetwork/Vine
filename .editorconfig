root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# hmm, the egg is exported by Pterodactyl as is, so leave its layout alone
[egg-vine.json]
indent_size = 4

[*.md]
# trailing double spaces are line breaks in markdown
trim_trailing_whitespace = false
